# ==============================================================================
# GoliathApp: Enterprise Application Concepts — local lab settings
# Copy to .env (never commit .env). Values are for a disposable local lab only.
# ==============================================================================

# Container bootstrap (compose.yaml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lab_bootstrap_superuser_pw
POSTGRES_DB=goliathapp_lab
PG_HOST_PORT=54339

# Client endpoint used by lab/setup_lab.py, tests and notebooks (loopback only)
PGHOST=127.0.0.1
PGPORT=54339
PGUSER=postgres
PGPASSWORD=lab_bootstrap_superuser_pw
PGDATABASE=goliathapp_lab

# Password setup_lab.py gives the least-privileged goliath_portal role (used by the portal and Module 2)
COURSE_PORTAL_DB_PASSWORD=lab_portal_pw_change_me

# Optional: use an existing GoliathApp checkout instead of the pinned clone under .lab/
# GOLIATHAPP_SRC=/path/to/GoliathApp

# Optional: portal tests (README section 5.3). Local-only secret; never on a shared portal.
# COURSE_PORTAL_URL=http://127.0.0.1:3410
# COURSE_PORTAL_DEV_LOGIN_SECRET=local-course-lab-only
